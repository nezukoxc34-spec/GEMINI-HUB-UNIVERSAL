local modules = {
    "Checking game PlaceId...",
    "Loading game configuration...",
    "Building user interface...",
    "Applying themes...",
    "Opening Olly Hubi..."
}

task.spawn(function()
    local totalSteps = 100
    for i = 1, totalSteps do
        local progress = i / totalSteps
        local tween = TweenService:Create(progressBar, TweenInfo.new(0.02, Enum.EasingStyle.Linear), {
            Size = UDim2.new(progress, 0, 1, 0)
        })
        tween:Play()
        percentLabel.Text = i .. "%"

        if i == 20 then statusLabel.Text = modules[2]
        elseif i == 50 then statusLabel.Text = modules[3]
        elseif i == 75 then statusLabel.Text = modules[4]
        elseif i == 90 then statusLabel.Text = modules[5]
        end

        task.wait(0.025)
    end

    statusLabel.Text = "Ready!"
    task.wait(0.15)

    local fadeLoader = TweenService:Create(loaderFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 280, 0, 0),
        BackgroundTransparency = 1
    })
    fadeLoader:Play()

    fadeLoader.Completed:Connect(function()
        loaderFrame:Destroy()

        main.Size = UDim2.new(0, 230, 0, 0)
        main.Visible = true
        
        local openMain = TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 230, 0, 290)
        })
        openMain:Play()
    end)
end)
