--// FIXED CUBE MINIMIZE
----------------------------------------------------
local minimized = false
local savedPos = main.Position

local cube = Instance.new("Frame")
cube.Size = UDim2.new(0, 45, 0, 45)
cube.Position = main.Position
cube.BackgroundColor3 = C.bg
cube.Visible = false
cube.Active = true
cube.Parent = gui
Instance.new("UICorner", cube).CornerRadius = UDim.new(0, 10)

local cubeStroke = Instance.new("UIStroke")
cubeStroke.Color = C.border
cubeStroke.Thickness = 2
cubeStroke.Parent = cube

local cubeLabel = Instance.new("TextLabel")
cubeLabel.Size = UDim2.new(1, 0, 1, 0)
cubeLabel.BackgroundTransparency = 1
cubeLabel.Text = "📜"
cubeLabel.TextSize = 22
cubeLabel.Parent = cube

local cubeDrag = false
local cubeStart, cubeStartPos
local hasMoved = false

cube.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        cubeDrag = true
        hasMoved = false
        cubeStart = input.Position
        cubeStartPos = cube.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if cubeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - cubeStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            hasMoved = true
        end
        cube.Position = UDim2.new(cubeStartPos.X.Scale, cubeStartPos.X.Offset + delta.X, cubeStartPos.Y.Scale, cubeStartPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if cubeDrag then
            cubeDrag = false
            if not hasMoved and minimized then
                minimized = false
                main.Position = cube.Position
                cube.Visible = false
                main.Visible = true
                main.Size = UDim2.new(0, 45, 0, 45)
                main.BackgroundTransparency = 0

                local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                local tweenRestore = TweenService:Create(main, tweenInfo, {
                    Size = UDim2.new(0, 230, 0, 290)
                })

                tweenRestore:Play()
                tweenRestore.Completed:Connect(function()
                    body.Visible = true
                    header.Visible = true
                end)
            end
        end
    end
end)

minBtn.MouseButton1Click:Connect(function()
    minimized = true
    savedPos = main.Position

    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local tweenMain = TweenService:Create(main, tweenInfo, {
        Size = UDim2.new(0, 45, 0, 45),
        BackgroundTransparency = 1
    })

    body.Visible = false
    header.Visible = false

    tweenMain:Play()
    tweenMain.Completed:Connect(function()
        main.Visible = false
        cube.Position = savedPos
        cube.Visible = true
    end)
end)

