end

local function createBlankSlider(name, yPos, min, max, default)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -16, 0, 46)
    row.Position = UDim2.new(0, 8, 0, yPos)
    row.BackgroundColor3 = C.off
    row.BorderSizePixel = 0
    row.Parent = body
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 50, 130)
    stroke.Thickness = 1
    stroke.Parent = row

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 18)
    label.Position = UDim2.new(0, 10, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. default
    label.TextColor3 = C.white
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(1, -20, 0, 12)
    sliderBtn.Position = UDim2.new(0, 10, 0, 26)
    sliderBtn.BackgroundColor3 = Color3.fromRGB(25, 18, 50)
    sliderBtn.Text = ""
    sliderBtn.AutoButtonColor = false
    sliderBtn.BorderSizePixel = 0
    sliderBtn.Parent = row
    Instance.new("UICorner", sliderBtn).CornerRadius = UDim.new(0, 4)

    local fill = Instance.new("Frame")
    local initPercent = math.clamp((default - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(initPercent, 0, 1, 0)
    fill.BackgroundColor3 = C.yellow
    fill.BorderSizePixel = 0
    fill.Parent = sliderBtn
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

    local activeDrag = false

    local function updateValue(input)
        local absPos = sliderBtn.AbsolutePosition.X
        local absSize = sliderBtn.AbsoluteSize.X
        local rel = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        local val = math.floor(min + rel * (max - min))
        label.Text = name .. ": " .. val
    end

    sliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = true
            updateValue(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if activeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input)
        end
    end)
end

