local flyVel, flyGyro, flyConn
local noclipParts = {}

local function stopFly()
    if flyVel then flyVel:Destroy() flyVel = nil end
    if flyGyro then flyGyro:Destroy() flyGyro = nil end
    if flyConn then flyConn:Disconnect() flyConn = nil end
end

local function unloadHubi()
    -- 1. Сброс флагов
    flags.fly = false
    flags.noclip = false
    flags.infjump = false
    flags.clicktp = false

    -- 2. Очистка полёта и коллизий
    stopFly()
    for part, col in pairs(noclipParts) do
        if part and part.Parent then part.CanCollide = col end
    end
    noclipParts = {}

    -- 3. Возврат стандартной скорости
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = 16 end

    -- 4. Отключение всех глобальных эвентов
    for _, conn in pairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}

    -- 5. Полное удаление GUI
    gui:Destroy()
end

